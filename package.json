{
  "name": "osmassist",
  "version": "0.1.0",
  "description": "Suggest OpenStreetMap tag changes from a feature's website with the help of an AI model. Every suggestion comes with a verbatim quote and must be approved by a human.",
  "author": "Andreas Neumann <andr.neumann@googlemail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyper85/osmAssist.git"
  },
  "keywords": [
    "OpenStreetMap",
    "opening_hours",
    "AI",
    "Claude"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./schema/answer-file.schema.json": "./schema/answer-file.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "schema": "npm run build && node scripts/write-schema.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
